<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="M2M.XmlEditor.Bootstrapper.Views.MainWindow"
        Title="M2M XML EDITOR Online Setup"
        Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
  <Grid Margin="28">
    <Grid x:Name="SetupPanel" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="M2M XML EDITOR telepítése" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="A legfrissebb stabil kiadás alapértelmezés szerint ki van választva." Opacity="0.72" />
      </StackPanel>

      <Border Grid.Row="1" Margin="0,20,0,0" Padding="16" CornerRadius="8" Background="#0A000000">
        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Telepített verzió:" FontWeight="SemiBold" />
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InstalledVersionText" Text="Vizsgálat..." />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Telepítendő release:" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ReleaseCombo" MinWidth="360" SelectionChanged="ReleaseCombo_OnSelectionChanged" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Telepítés hatóköre:" FontWeight="SemiBold" />
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InstallScopeText" Text="–" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Adatbázis:" FontWeight="SemiBold" />
          <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DatabaseText" Text="–" />
        </Grid>
      </Border>

      <CheckBox Grid.Row="2" Margin="2,14,0,0" x:Name="CloneH2CheckBox"
                Content="Az előző H2 konfigurációjának és adatainak másolása az új verzióhoz"
                IsEnabled="False" />

      <Border Grid.Row="3" Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="#08000000">
        <StackPanel Spacing="8">
          <TextBlock TextWrapping="Wrap"
                     Text="A telepítés csak a licenc- és felhasználási feltételek megtekintése után indítható. Az alkalmazás konfigurációja az első indításkor a setup.html felületen történik." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="LicenseButton" Content="Licenc megtekintése" HorizontalAlignment="Left" Click="LicenseButton_OnClick" />
            <Button x:Name="ThirdPartyLicensesButton" Content="Harmadik féltől származó licencek" HorizontalAlignment="Left" Click="ThirdPartyLicensesButton_OnClick" IsVisible="False" />
            <TextBlock x:Name="LicenseStatusText" Text="A Telepítés folytatásához olvassa el és fogadja el a licencfeltételeket." VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>


      <Border Grid.Row="4" x:Name="LegacyCompatibilityBorder" IsVisible="False" Margin="0,16,0,0" Padding="14" CornerRadius="6" Background="#16C87800">
        <StackPanel Spacing="9">
          <TextBlock Text="Korábbi telepítés kompatibilitási védelme" FontWeight="SemiBold" />
          <TextBlock x:Name="LegacyCompatibilityStatus" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ComboBox Grid.Column="0" x:Name="LegacyUninstallCombo" MinWidth="380" />
            <Button Grid.Column="1" x:Name="LegacyUninstallButton" Content="Korábbi telepítés eltávolítása" Click="LegacyUninstallButton_OnClick" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="5" Margin="0,18,0,0" Spacing="7">
        <TextBlock x:Name="StageText" Text="Release-lista betöltése..." FontWeight="SemiBold" />
        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="18" />
        <TextBlock x:Name="DetailText" Text="" Opacity="0.72" TextTrimming="CharacterEllipsis" />
        <Border x:Name="ErrorBorder" IsVisible="False" Margin="0,8,0,0" Padding="12" CornerRadius="6" Background="#18C62828">
          <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <TextBlock Grid.Row="6" Margin="0,18,0,6" Text="Napló" FontWeight="SemiBold" />
      <TextBox Grid.Row="7" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas" FontSize="12" />

      <Grid Grid.Row="8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,18,0,0">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.65"
                   Text="Java 21, Maven és MinGit a bootstrapper saját cache-éből fut; a rendszer telepítéseit nem módosítja." />
        <Button Grid.Column="1" x:Name="RefreshButton" Content="Release-ek frissítése" Click="RefreshButton_OnClick" />
        <Button Grid.Column="2" x:Name="InstallButton" Content="Telepítés"
                Click="InstallButton_OnClick" IsEnabled="False" />
      </Grid>
    </Grid>

  </Grid>
</Window>
